# Which implementation /api/fill-form uses by default when a request omits
# "provider". "mock" | "anthropic". Read at runtime via $env/dynamic/private,
# so changing it in the Vercel dashboard takes effect on redeploy without a
# code change. A request can still override this per-call with
# { "provider": "anthropic" }.
FILL_FORM_PROVIDER=mock

# Required once FILL_FORM_PROVIDER=anthropic, or any request passes provider="anthropic".
# Get one from console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=

# LangSmith tracing. Get LANGSMITH_API_KEY from smith.langchain.com -> Settings
# -> API Keys. Leave LANGSMITH_TRACING unset/false to disable tracing entirely
# (e.g. local dev) without touching code.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=formfill
